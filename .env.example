# OpenAI — server only
OPENAI_API_KEY=your_openai_project_api_key
OPENAI_ANALYSIS_MODEL=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high

# Set true to run a vision QA pass and retry a severe failure once.
ENABLE_IMAGE_VALIDATION=false

# Supabase project configuration (server-only; no NEXT_PUBLIC_ prefix required)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret
SUPABASE_STORAGE_BUCKET=ad-mats

# Random secret used to sign 24-hour browser session capabilities.
# Generate one with: openssl rand -hex 32
ADMAT_SESSION_SECRET=a_random_secret_of_at_least_32_characters
